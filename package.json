{
  "name": "calendar",
  "version": "0.6.8",
  "description": "Offline desktop Google Calendar clone",
  "desktopName": "calendar",
  "author": {
    "name": "LinuxBeste",
    "email": "linuxbeste@users.noreply.github.com"
  },
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts",
    "server:watch": "tsx watch server/index.ts",
    "rebuild:node": "npm rebuild better-sqlite3",
    "build:web": "vite build -c vite.web.config.ts",
    "build:demo": "vite build -c vite.web.config.ts --mode demo",
    "dev:web": "vite -c vite.web.config.ts",
    "build:android": "npm run build:web && npx cap sync android",
    "android:run": "npm run build:android && npx cap open android",
    "dist": "electron-vite build && electron-builder -p never",
    "dist:win": "electron-vite build && electron-builder --win -p never",
    "dist:mac": "electron-vite build && electron-builder --mac -p never",
    "dist:linux": "electron-vite build && electron-builder --linux -p never"
  },
  "build": {
    "appId": "dev.linuxbeste.calendar",
    "productName": "Calendar",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-installer.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}-portable.${ext}",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Utility",
      "syncDesktopName": true
    },
    "publish": {
      "provider": "github",
      "owner": "LinuxBeste",
      "repo": "Calendar_noone_asked_for"
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    },
    "dmg": {
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "better-sqlite3": "^12.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "fastify": "^5.11.2",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rrule": "^2.8.1",
    "tsx": "^4.23.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/share": "^8.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.21.2"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "electron@37.10.3": true
  }
}
