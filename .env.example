# Copy to .env and adjust. See README "Docker (optional backend)".

# PostgreSQL (used when set; otherwise the app falls back to SQLite)
CALENDAR_PG_URL=postgres://calendar:calendar@localhost:5432/calendar
CALENDAR_PG_USER=calendar
CALENDAR_PG_PASSWORD=calendar
CALENDAR_PG_DB=calendar

# Redis (used when set; otherwise the app falls back to in-memory cache)
CALENDAR_REDIS_URL=redis://localhost:6379

# Server port (default 3001) and host (default 0.0.0.0)
# CALENDAR_PORT=3001
# CALENDAR_HOST=0.0.0.0

# API key for system-level calls (e.g. the reminder poller). Sent as X-Api-Key.
# No default: the /reminders/due and /reminders/:id/sent routes require this key
# (or a user Bearer token) and are rejected otherwise.
# CALENDAR_API_KEY=change-me

# Comma-separated CORS allowlist for the web client (defaults below if unset):
# http://localhost:5173, http://127.0.0.1:5173, https://localhost
# CALENDAR_CORS_ORIGINS=https://calendar.example.com
